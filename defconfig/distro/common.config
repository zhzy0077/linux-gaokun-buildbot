# Packaging identity: kernel release is shared with existing Gaokun boot integration.
CONFIG_LOCALVERSION="-gaokun3"
# CONFIG_LOCALVERSION_AUTO is not set

# Vendor private keys/certificate bundles are not in the upstream source tree.
# Keep module-signature support and automatic local build-key generation enabled.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# Both vendor baselines enable Rust and BTF; CI must provide their toolchains.
CONFIG_RUST=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
