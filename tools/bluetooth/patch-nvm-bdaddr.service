[Unit]
Description=Maintain QCA Bluetooth NVM BDADDR (also prepared by the hci_uart modprobe hook)
DefaultDependencies=no
After=local-fs.target
Before=bluetooth.service
ConditionPathExists=/usr/local/bin/patch-nvm-bdaddr.py
ConditionPathExistsGlob=/lib/firmware/qca/*hpnv21*

[Service]
Type=oneshot
ExecStart=/usr/local/bin/patch-nvm-bdaddr.py

[Install]
WantedBy=multi-user.target
