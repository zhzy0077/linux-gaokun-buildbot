+config TCG_QCOM_TPM_QSEE
+	tristate "Gaokun3 Qualcomm QSEE fTPM validation"
+	depends on QCOM_QSEECOM && OF && !TCG_TPM2_HMAC
+	help
+	  Opt-in transport for the firmware-preloaded qcom.tz.tpm application
+	  on Huawei Gaokun3. The fixed firmware control area uses HLOS sharing
